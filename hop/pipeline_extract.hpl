<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>TABLE_NAME</name>
        <description>Nome da tabela de origem</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>TARGET_SCHEMA</name>
        <description>Nome do schema de destino</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>pipeline_extract</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/04 19:51:11.074</created_date>
    <modified_date>2026/10/04 19:51:11.074</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT * FROM ${TABLE_NAME}</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>conn_source</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Table output</name>
    <connection>conn_target</connection>
    <schema>bronze</schema>
    <table>raw_${TABLE_NAME}</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>Y</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>Y</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>customer_id</stream_name>
        <column_name>customer_id</column_name>
      </field>
      <field>
        <stream_name>company_name</stream_name>
        <column_name>company_name</column_name>
      </field>
      <field>
        <stream_name>contact_name</stream_name>
        <column_name>contact_name</column_name>
      </field>
      <field>
        <stream_name>contact_title</stream_name>
        <column_name>contact_title</column_name>
      </field>
      <field>
        <stream_name>address</stream_name>
        <column_name>address</column_name>
      </field>
      <field>
        <stream_name>city</stream_name>
        <column_name>city</column_name>
      </field>
      <field>
        <stream_name>region</stream_name>
        <column_name>region</column_name>
      </field>
      <field>
        <stream_name>postal_code</stream_name>
        <column_name>postal_code</column_name>
      </field>
      <field>
        <stream_name>country</stream_name>
        <column_name>country</column_name>
      </field>
      <field>
        <stream_name>phone</stream_name>
        <column_name>phone</column_name>
      </field>
      <field>
        <stream_name>fax</stream_name>
        <column_name>fax</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Table input</from>
      <to>Table output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
